# Database Configuration
# URL de conexión a PostgreSQL
# Formato: postgresql://[usuario]:[contraseña]@[host]:[puerto]/[nombre_bd]
DATABASE_URL=postgresql://app:app@localhost:5432/appdb

# Logging Configuration
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Redis Cache Configuration
# URL de conexión a Redis
# Formato: redis://[usuario]:[contraseña]@[host]:[puerto]/[db]
REDIS_URL=redis://localhost:6379/0
# TTL del caché en segundos (por defecto 3600 = 1 hora)
REDIS_TTL=3600

# File Import Configuration
# Ruta temporal para descargar y descomprimir archivos de geonames.org
# Los archivos descargados se almacenan aquí durante el proceso de importación
TEMP_PATH=./tmp
